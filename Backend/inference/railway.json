{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Backend/inference/Dockerfile",
    "watchPatterns": [
      "Backend/inference/**",
      "Backend/plantvision/src/**",
      "Backend/plantvision/configs/**",
      "Backend/plantvision/models/**",
      "Backend/plantvision/pyproject.toml"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "sleepApplication": true
  }
}
