# Set by the host in production.
PORT=8000
# Shared secret; the api sends it as x-inference-key. At least 16 characters; same value as the api's.
INFERENCE_API_KEY=replace-with-a-long-random-secret
# Returned in every response and by /health. A non-stub value requires ML_WEIGHTS_PATH.
MODEL_VERSION=stub-0.1
# Trained NDVI bundle written by Backend/plantvision/training/ndvi/pipeline.py. Unset = stub.
# A relative path resolves from the working directory; use an absolute path in production.
# ML_WEIGHTS_PATH=/app/inference/weights/model.json
# stub (hardcoded values) or plantvision (needs requirements-cv.txt and pip install -e ../plantvision).
CV_ENGINE=stub
