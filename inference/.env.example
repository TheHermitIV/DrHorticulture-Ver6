# Set by the host in production.
PORT=8000
# Shared secret; the api sends it as x-inference-key. At least 16 characters; same value as the api's.
INFERENCE_API_KEY=replace-with-a-long-random-secret
# Returned in every response and by /health.
MODEL_VERSION=stub-0.1
# stub (hardcoded values) or plantvision (needs requirements-cv.txt and pip install -e ../plantvision).
CV_ENGINE=stub
