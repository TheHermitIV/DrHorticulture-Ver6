{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "inference/Dockerfile",
    "watchPatterns": [
      "inference/**",
      "plantvision/src/**",
      "plantvision/configs/**",
      "plantvision/models/**",
      "plantvision/pyproject.toml"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "sleepApplication": true
  }
}
