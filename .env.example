# Optional environment overrides for PlantVision.
# These are read directly from the environment; no .env loader is required.
# You can copy this file to .env and export its values, or set them before running.

# Directory containing default.yaml / segmentation.yaml / ndvi.yaml
# PLANTVISION_CONFIG_DIR=configs

# Directory where CLI writes prediction.json, features.json, mask.png, overlay.png
# PLANTVISION_OUTPUT_DIR=outputs