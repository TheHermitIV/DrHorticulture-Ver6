{
  "name": "drhorticulture-api",
  "version": "0.1.0",
  "private": true,
  "description": "DrHorticulture Ver6 public API: upload, quality gate, inference, decision policy",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "express": "5.2.1",
    "multer": "2.4.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "vitest": "5.0.3"
  }
}
