# Copy to api/.env for local development (npm run dev loads it). Never commit .env.
# On Railway, set these as service variables instead.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Supabase dashboard -> Project Settings -> API. The service-role key is secret: server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_BUCKET=scan-images

# mock | remote. Keep mock during development. INFERENCE_URL and INFERENCE_API_KEY are required
# only when INFERENCE_MODE=remote. Use https:// whenever inference is reachable from the internet.
# INFERENCE_API_KEY is the shared secret sent as x-inference-key; set the same value on the
# inference service. At least 16 characters (generate it like ADMIN_API_KEY below).
INFERENCE_MODE=mock
INFERENCE_URL=
INFERENCE_API_KEY=
INFERENCE_TIMEOUT_MS=60000

MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MIN=30

# At least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replace-with-a-long-random-string

AUTH_REQUIRED=false
