{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DrHorticulture inference contract v1",
  "description": "POST /v1/analyze between the api and the inference service. v1 is never changed in place; a breaking change becomes /v2/analyze with contracts/inference.v2.*.",
  "$defs": {
    "AnalyzeRequest": {
      "description": "Request body, api -> inference.",
      "type": "object",
      "required": ["image_url", "species", "image_id"],
      "properties": {
        "image_url": {
          "type": "string",
          "format": "uri",
          "description": "Supabase signed URL, valid 5 minutes. The service downloads the image itself."
        },
        "species": { "type": "string", "minLength": 1, "maxLength": 64 },
        "image_id": { "type": "string", "format": "uuid" }
      }
    },
    "AnalyzeResponse": {
      "description": "200 response body, inference -> api. The api treats any response that fails this schema as a failure.",
      "type": "object",
      "required": ["model_version", "segmentation", "features", "estimate"],
      "properties": {
        "model_version": { "type": "string", "minLength": 1 },
        "segmentation": {
          "description": "CV stage output.",
          "type": "object",
          "required": ["plant_detected", "mask_confidence", "leaf_fraction"],
          "properties": {
            "plant_detected": { "type": "boolean" },
            "mask_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "leaf_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "features": {
          "description": "CV stage color features; any keys, numeric values, may be empty.",
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "estimate": {
          "description": "ML stage output.",
          "type": "object",
          "required": ["ndvi", "confidence"],
          "properties": {
            "ndvi": { "type": "number", "minimum": -1, "maximum": 1 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "checks": {
          "type": "object",
          "properties": {
            "angle_ok": {
              "type": "boolean",
              "description": "Treated as true when absent."
            },
            "calibration_card": {
              "type": "boolean",
              "description": "Recorded only, not enforced."
            }
          }
        }
      }
    },
    "ErrorResponse": {
      "description": "Any 4xx/5xx body from the inference service.",
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
